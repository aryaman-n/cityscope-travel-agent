# mock is deterministic and works without network access; live uses public APIs.
DATA_MODE=mock
MOCK_LATENCY_SECONDS=0.10
API_TIMEOUT_SECONDS=10

# Optional. Both USE_LLM=true and a key are required to call OpenAI.
USE_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional override. Defaults to .travel_data/chroma inside the repository.
VECTOR_DB_PATH=
